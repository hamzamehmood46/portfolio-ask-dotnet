@inject AppState State
@inject IJSRuntime Js

<main class="app">
    <header class="top">
        <div class="brand">
            <span class="logo" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><path d="M4 5h16v11H11l-5 4v-4H4z" /></svg></span>
            <div>
                <h1>Ask my portfolio</h1>
                <p class="sub">Answers come only from Hamza's project READMEs, with sources.</p>
            </div>
        </div>
        <div class="top-actions">
            <span class="pill" title="The search and the model are simple stand-ins">Stand-in model</span>
            <button type="button" class="ghost" @onclick="Clear" disabled="@(turns.Count == 0)">Clear</button>
        </div>
    </header>

    <details class="about">
        <summary>How this works, and what it can't do</summary>
        <p>The model here is a stand-in. It copies the sentences that best match your question and cites them. It does not paraphrase or reason, the search matches words rather than meaning, and it keeps no memory between questions. If the docs do not cover a question, it says so and cites nothing.</p>
    </details>

    @if (State.LoadError is not null)
    {
        <p class="error" role="alert">@State.LoadError</p>
    }
    else if (!ready)
    {
        <div class="log"><p class="muted" role="status">Loading the documents&hellip;</p></div>
    }
    else
    {
        <section class="log" aria-live="polite" aria-label="Conversation">
            @if (turns.Count == 0)
            {
                <div class="empty">
                    <h2>What would you like to know?</h2>
                    <p>Pick a question below or type your own. One of them is something the docs do not cover, on purpose.</p>
                </div>
            }

            @foreach (var t in turns)
            {
                <div class="msg user"><p>@t.Question</p></div>
                <article class="msg bot @Css(t.Answer.Status)">
                    <p class="answer">@t.Answer.Text</p>
                    @if (t.Answer.Citations.Count > 0)
                    {
                        <div class="sources" role="group" aria-label="Sources">
                            @foreach (var c in t.Answer.Citations)
                            {
                                <button type="button" class="src @(t.Open == c.ChunkId ? "on" : "")" @onclick="() => Toggle(t, c.ChunkId)" aria-expanded="@(t.Open == c.ChunkId)">
                                    <span class="doc">@c.Source</span><span class="h">@Short(c.Heading)</span>
                                </button>
                            }
                        </div>
                        @if (t.Open is not null && t.Answer.Citations.Any(c => c.ChunkId == t.Open))
                        {
                            <blockquote>@FullText(t.Open)</blockquote>
                        }
                    }
                    @if (t.Answer.Reason is not null)
                    {
                        <p class="reason">@t.Answer.Reason</p>
                    }
                    <details class="why">
                        <summary>What was retrieved</summary>
                        <ol>
                            @foreach (var h in t.Answer.Considered)
                            {
                                <li>
                                    <span class="rid"><code>@h.Chunk.Id</code> <span class="muted">@Short(h.Chunk.Heading)</span></span>
                                    <span class="meter" aria-hidden="true"><i style="width:@(Math.Min(100, (int)(h.Score * 100)))%"></i></span>
                                    <span class="score">@h.Score.ToString("0.00")</span>
                                </li>
                            }
                            @if (t.Answer.Considered.Count == 0)
                            {
                                <li class="muted">Nothing matched.</li>
                            }
                        </ol>
                    </details>
                </article>
            }
        </section>

        <div class="dock">
            <div class="samples" role="group" aria-label="Sample questions">
                @foreach (var s in Samples)
                {
                    <button type="button" class="chip" @onclick="() => Use(s)">@s</button>
                }
            </div>
            <form class="ask" @onsubmit="Submit" @onsubmit:preventDefault>
                <label for="q" class="sr">Your question</label>
                <input id="q" type="text" maxlength="500" placeholder="Ask about a project or about Hamza" @bind="question" @bind:event="oninput" autocomplete="off" />
                <button type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(question))" aria-label="Ask">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </button>
            </form>
            <p class="foot"><a href="https://github.com/hamzamehmood46/portfolio-ask-dotnet" target="_blank" rel="noopener">Source on GitHub</a> &middot; nothing leaves your browser</p>
        </div>
    }
</main>

@code {
    private static readonly string[] Samples =
    [
        "How does the SLA clock pause?",
        "What happens when two people pick the same seat?",
        "What is the outbox pattern?",
        "Where did Hamza study?",
        "What is Hamza's favorite food?",
    ];

    private sealed class Turn
    {
        public required string Question { get; init; }
        public required Answer Answer { get; init; }
        public string? Open { get; set; }
    }

    private readonly List<Turn> turns = [];
    private string question = "";
    private bool ready;
    private bool busy;
    private bool scrollNext;

    protected override async Task OnInitializedAsync()
    {
        await State.EnsureLoadedAsync();
        ready = State.Assistant is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollNext)
        {
            scrollNext = false;
            await Js.InvokeVoidAsync("askScroll");
        }
    }

    private void Use(string sample)
    {
        question = sample;
        _ = Submit();
    }

    private void Clear()
    {
        turns.Clear();
        question = "";
    }

    private async Task Submit()
    {
        if (busy || State.Assistant is null || string.IsNullOrWhiteSpace(question))
        {
            return;
        }

        busy = true;
        var asked = question.Trim();
        question = "";
        var answer = await State.Assistant.AskAsync(asked);
        turns.Add(new Turn { Question = asked, Answer = answer, Open = null });
        scrollNext = true;
        busy = false;
    }

    private static void Toggle(Turn t, string id) => t.Open = t.Open == id ? null : id;

    private string FullText(string chunkId) => State.Index?.Find(chunkId)?.Text ?? "";

    // The last heading level is the most telling part; the path above it is shown on hover elsewhere.
    private static string Short(string heading) => heading.Contains(" > ") ? heading[(heading.LastIndexOf(" > ", StringComparison.Ordinal) + 3)..] : heading;

    private static string Css(AnswerStatus s) => s switch
    {
        AnswerStatus.Answered => "ok",
        AnswerStatus.NoAnswer => "none",
        _ => "bad",
    };
}
